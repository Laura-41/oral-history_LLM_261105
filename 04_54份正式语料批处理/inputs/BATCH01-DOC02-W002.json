  "interviewee": "陈锐霆",
  "window_number": 2,
  "is_first_window": false,
  "is_last_window": false,
  "task_scope": "正式语料连续窗口盲抽取；事件数量和边界未知。",
  "source_segments": [
    {
      "segment_id": "BATCH01-DOC02-S0029",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 29,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0029",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "记者：陈老，那平汉线这一仗为什么打得损失这么大？是战斗力不行还是武器装备不行？"
    },
    {
      "segment_id": "BATCH01-DOC02-S0030",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 30,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0030",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：12：23：12"
    },
    {
      "segment_id": "BATCH01-DOC02-S0031",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 31,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0031",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：爱国的思想都是挺坚定的，打仗也很勇敢的，就是装备落后！我们那个时候就是有一个机枪、步枪、重机关枪、迫击炮，就这么些装备，那个时候那个炮兵还没用得上。 "
    },
    {
      "segment_id": "BATCH01-DOC02-S0032",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 32,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0032",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：13：18：23"
    },
    {
      "segment_id": "BATCH01-DOC02-S0033",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 33,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0033",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：因为商震他是很爱国的，所以这个部队作风也很正派的，战斗力还是很不错的。打那里一仗以后，敌人到石家庄，不想到山西去，就打那个地方，我们也没守备，他到那个地方过一下子就继续向南了。我们就在元氏县抵抗。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0034",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 34,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0034",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：14：13：09"
    },
    {
      "segment_id": "BATCH01-DOC02-S0035",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 35,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0035",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：我这个连啊奉的命令，急行军到元氏，（联系）717团，那个时候（这个团）又刚编成旅了。吃了晚饭以后飞机睡觉的时候就出发，急行军走了一夜，到了第二天的早晨八点来钟才到了元氏的城南边偏西一点，在那个地方休息、"
    },
    {
      "segment_id": "BATCH01-DOC02-S0036",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 36,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0036",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：15：10：02"
    },
    {
      "segment_id": "BATCH01-DOC02-S0037",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 37,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0037",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：做饭、喂牲口，人吃马喂嘛。这个时候我就派人去找我们配属的717团，当时到那个地方找不到。这个时候前边已经响了枪了，他这个部队和指挥员一会儿到这儿一会儿到那儿去，也没找到。马上敌人的火炮就往城里面打得挺凶，我们部队啊最初三三两两的，以后都是小部队往南撤了。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0038",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 38,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0038",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：16：08：12"
    },
    {
      "segment_id": "BATCH01-DOC02-S0039",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 39,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0039",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：我一看这个情况不好，他们两拨人回来都没跟717团联系上。所以我看了形势不好啊，我又把部队带着，沿着太行山的西边跟前那个马路经过赞皇县以后到了邢台。以后就过了太行山转到山西那个辽县。为什么过去呢，不能往前继续前进呢？ "
    },
    {
      "segment_id": "BATCH01-DOC02-S0040",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 40,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0040",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：17：15：09"
    },
    {
      "segment_id": "BATCH01-DOC02-S0041",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 41,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0041",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：听说磁县那个地方发现敌人的便衣队、游击队，所以我转到辽县想绕过去。这个时候我派两批人，找我们部队联系，另外告诉他们我们就要转移到辽县去。在辽县待了三四天，派那两个人回来都（说）没联系上，我就带着部队继续向南。到了山西长治，又派人出去，给我联系上了。哎呀，他们挺高兴的，听说我们还存在，他们认为我们已经叫敌人消灭了。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0042",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 42,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0042",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：18：20：20"
    },
    {
      "segment_id": "BATCH01-DOC02-S0043",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 43,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0043",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "记者：陈老，那个时候国民党军队打仗的时候还有一股子爱国热情，很勇猛，但是撤退的时候好像好多部队就散了，经常会这样。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0044",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 44,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0044",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "为什么会撤退的时候就不能够完整地撤下来？"
    },
    {
      "segment_id": "BATCH01-DOC02-S0045",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 45,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0045",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：撤退的时候抵抗不住。留得青山在，不怕没柴烧，有这个思想嘛。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0046",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 46,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0046",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：19：07：12  "
    },
    {
      "segment_id": "BATCH01-DOC02-S0047",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 47,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0047",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：我再到别的地方打嘛。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0048",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 48,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0048",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "记者：那个时候部队里边的兵员主要是征过来的兵，还是抓壮丁的兵？"
    },
    {
      "segment_id": "BATCH01-DOC02-S0049",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 49,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0049",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：那个时候都是招的，都是穷困没办法生活了，来找饭吃嘛。都是家里穷得不得了了，当了兵的收入多，没职业嘛！"
    },
    {
      "segment_id": "BATCH01-DOC02-S0050",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 50,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0050",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "记者：当兵是为了找一个出路。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0051",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 51,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0051",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：当兵为糊口嘛，吃饭嘛，没有说为了爱国当兵的。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0052",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 52,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0052",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：20：07：20"
    },
    {
      "segment_id": "BATCH01-DOC02-S0053",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 53,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0053",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：这样的人不太多，可能也有，但是不多。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0054",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 54,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0054",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "记者：部队里边撤退的时候逃跑的兵多不多？ "
    },
    {
      "segment_id": "BATCH01-DOC02-S0055",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 55,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0055",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：逃跑的，回家的不多。我那个部队没有（私自）回（家）的。我带的连在这样的形势底下到了邢台，过了辽县，辽县到长治，以后又派人到平汉路去了解情况，再以后跟军部联系上。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0056",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 56,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0056",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：21：13：10"
    },
    {
      "segment_id": "BATCH01-DOC02-S0057",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 57,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0057",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：（军部）叫我到新乡啊，先到新乡以后往北，打焦作，一直向新乡方向，以后就回到部队。回到部队我这个部队不仅没有损失，路上还招了一个青年，一个当兵的，我那个连100多人嘛。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0058",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 58,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0058",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：22：13：10"
    },
    {
      "segment_id": "BATCH01-DOC02-S0059",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 59,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0059",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：我回到部队，军部跟炮兵团的团部都很高兴，都认为我已经在元氏那一仗叫敌人消灭了。接着部队继续后撤，撤到郑州吧，这个时候我们那个营长，也是商震老朋友的孩子，陆军大学毕业的，叫魏汝林，调别的部队去了，调到上级去了，就把我提升为三营的营长。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0060",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 60,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0060",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：23：23：13"
    },
    {
      "segment_id": "BATCH01-DOC02-S0061",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 61,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0061",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：我这个营部就驻在河南襄城县，在这个地方练兵。这个时候接命令派一个连到黄河南岸（做）游动炮兵。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0062",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 62,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0062",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "记者：游动炮兵是什么意思？"
    },
    {
      "segment_id": "BATCH01-DOC02-S0063",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 63,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0063",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：游动就是来回走着，不在一个固定的地，就沿着河边侦察，哪个地方看看有没有敌人渡河。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0064",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 64,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0064",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：24：13：12"
    },
    {
      "segment_id": "BATCH01-DOC02-S0065",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 65,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0065",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：大概5月10号前后，突然来一个紧急命令，说炮兵团带着一营，跟我这个营的（一部），五个连，另外一个营到徐州去会战去了，没有在这里在32军参谋长统一指挥底下，到了菏泽，守菏泽。"
    },
    {
      "segment_id": "BATCH01-DOC02-S0066",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 66,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0066",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "记者：这个时候是土肥原的日军南下是吧？"
    },
    {
      "segment_id": "BATCH01-DOC02-S0067",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 67,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0067",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "00：25：21：12"
    },
    {
      "segment_id": "BATCH01-DOC02-S0068",
      "document_id": "03.陈锐霆 090423（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC02",
      "segment_order": 68,
      "part": "document",
      "source_block_id": "03.陈锐霆 090423（二校后 阅读版）.docx-B0068",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "陈锐霆：就是土肥原的一个师，日本的14师，是一个主力师吧，配备了有坦克、大炮、空中的飞机。那个炮队都有系留气球，系留气球在城上边悬起来，把城里边的情况看得清清楚楚的。"
    }
  ]
}
