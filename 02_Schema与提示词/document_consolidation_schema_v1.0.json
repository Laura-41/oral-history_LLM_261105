{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.oral-history.example/schema/document-consolidation-v1.0.json",
  "title": "口述史文档级候选归并与经历范围 Schema v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "technical_document_id",
    "document_id",
    "interviewee",
    "document_events",
    "candidate_decisions"
  ],
  "properties": {
    "schema_version": {"const": "document-consolidation-v1.0"},
    "technical_document_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "interviewee": {"type": "string", "minLength": 1},
    "document_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_event_id",
          "source_candidate_ids",
          "source_segment_ids",
          "experience_scope",
          "participation_bases",
          "scope_evidence_segment_ids",
          "scope_evidence_quote",
          "completeness",
          "canonical_event",
          "review_status",
          "review_reason"
        ],
        "properties": {
          "document_event_id": {"type": "string", "minLength": 1},
          "source_candidate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_segment_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "experience_scope": {
            "enum": ["PERSONAL_EXPERIENCE", "NARRATED_CONTEXT", "UNCERTAIN"]
          },
          "participation_bases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "DIRECT_FIRST_PERSON",
                "DIRECTLY_AFFECTED",
                "COLLECTIVE_WITH_ROLE",
                "COLLECTIVE_WITHOUT_ROLE",
                "REPORTED_BY_OTHERS",
                "EXPLICIT_NON_PARTICIPATION",
                "THIRD_PARTY_ONLY",
                "EDITORIAL_SOURCE",
                "INSUFFICIENT_EVIDENCE"
              ]
            }
          },
          "scope_evidence_segment_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "scope_evidence_quote": {"type": "string", "minLength": 1},
          "completeness": {"enum": ["COMPLETE", "INCOMPLETE", "UNCERTAIN"]},
          "canonical_event": {"$ref": "event_candidate_schema_v1.0.json"},
          "review_status": {"enum": ["AUTO_VALIDATED", "NEEDS_REVIEW"]},
          "review_reason": {"type": ["string", "null"]}
        }
      }
    },
    "candidate_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "action", "document_event_ids", "reason"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "action": {
            "enum": ["MERGED", "KEPT", "SPLIT", "CONTEXT_ONLY", "REJECTED_AS_NON_EVENT"]
          },
          "document_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
