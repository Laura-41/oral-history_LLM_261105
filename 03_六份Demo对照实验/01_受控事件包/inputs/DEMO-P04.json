{
  "packet_version": "v1.0",
  "packet_id": "DEMO-P04",
  "doc_id": "CHF-V3-01",
  "document_title": "陈海峰三访01",
  "interviewee": "陈海峰",
  "task_scope": "人工已判定以下片段共同构成一个候选一级事件；请重建其理论类型和结构。",
  "source_segments": [
    {
      "segment_id": "CHF-V3-01-S0004",
      "segment_order": 4,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "3支队呢，新四军刚成立的时候，一共四个支队，江北（是）4支队，高敬亭的。1支队是陈毅、王必成他们，傅秋涛是副司令。2支队（是）粟裕、张鼎丞。"
    },
    {
      "segment_id": "CHF-V3-01-S0005",
      "segment_order": 5,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "张鼎丞是司令员，粟裕是政委。那个时候不能叫政委，都叫副司令，副司令呢，（实际上）都是政委。新四军的副军长项英呢，实际上也等于是政委。所以政委都不叫“政委”，（支队政委）都叫“副团长”。"
    },
    {
      "segment_id": "CHF-V3-01-S0007",
      "segment_order": 7,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "    陈海峰：那么3支队呢，正的是张云逸，（他）是新四军参谋长兼司令员，实际上他没有到位。"
    },
    {
      "segment_id": "CHF-V3-01-S0009",
      "segment_order": 9,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "后来成立江北指挥部，他在江北指挥部当总指挥了。"
    },
    {
      "segment_id": "CHF-V3-01-S0010",
      "segment_order": 10,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "张云逸后来当副军长，（他）是广西的。张云逸是司令员，副司令是谭震林。谭震林叫副司令员，实际上是政委。张云逸没有到位呢，实际上都是谭震林统一指挥。"
    },
    {
      "segment_id": "CHF-V3-01-S0016",
      "segment_order": 16,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "（他）文化原来不高，可是他（的）思维很好，战斗经验很丰富，很灵活。3支队当时（是）他统一指挥。"
    },
    {
      "segment_id": "CHF-V3-01-S0017",
      "segment_order": 17,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "那么皖南事变之前，他又到江南去了，编成个6师，当时不叫6师，叫江抗啊。"
    },
    {
      "segment_id": "CHF-V3-01-S0020",
      "segment_order": 20,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "陈海峰：这一块地方呢，都是谭震林统一指挥。"
    },
    {
      "segment_id": "CHF-V3-01-S0022",
      "segment_order": 22,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "那么陈毅、粟裕呢，（领导）江南指挥部，后来陈毅、粟裕到江北去了，（江南）就一直是谭震林统一指挥。"
    },
    {
      "segment_id": "CHF-V3-01-S0023",
      "segment_order": 23,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "那么谭震林走了以后呢，是谁来当司令员？是张正坤，皖南事变的时候，3支队的司令员是张正坤。"
    },
    {
      "segment_id": "CHF-V3-01-S0024",
      "segment_order": 24,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "张正坤呢，在皖南事变中负重伤，被俘，以后牺牲了。张正坤司令员来3支队没有多久"
    },
    {
      "segment_id": "CHF-V3-01-S0027",
      "segment_order": 27,
      "speaker_type": "INTERVIEWEE",
      "verbatim_text": "    陈海峰：那么3支队的，实际上3年中间呢，党、政、军都由谭震林统一指挥。"
    }
  ]
}
