  "source_segments": [
    {
      "segment_id": "BATCH01-DOC03-S0002",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 2,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0002",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：00：12"
    },
    {
      "segment_id": "BATCH01-DOC03-S0003",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 3,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0003",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "    记者：杨老那咱们接着上午继续讲，讲平型关大捷，从冉庄集结之后就奔赴平型关了，您老接着讲。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0004",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 4,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0004",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：我们在冉庄集结的时候啊，中国方面阎锡山和中央军在平型关的沿长城线集中了20多个团，还有好几个炮兵团。他是在那里准备抵抗的，我们去抄后路。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0005",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 5,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0005",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：01：03"
    },
    {
      "segment_id": "BATCH01-DOC03-S0006",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 6,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0006",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：另外敌人方面呢，他已经占领了我们要打他那个地方，我好像也记不得那个叫什么合城（音）了，再往西南一点呢是叫东西跑池。沿着这个公路呢，离平型关呢大概十几里路吧，日本兵呢已经到了东西跑池的那个地方。这后边呢，二三里路的地方啊，就已经囤积了大量的物资、炮弹，里边有粮食，有干粮、饼干，大箱子，铁箱子。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0007",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 7,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0007",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：02：20"
    },
    {
      "segment_id": "BATCH01-DOC03-S0008",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 8,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0008",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：到后边呢，他走的呢还在灵丘、广陵的后边。当时老百姓报告呢，日本人啊非常地野蛮，见人就打。在庄稼地里干活吧，人家离那公路几里地，他那个三八式的枪不是打得比较远，我们枪也可以打那么远，射程都差不多，他就坐到汽车上，当这个靶子来打我们的群众，所以群众非常恨这个（事），八路军到了那里，老远就来通报情况。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0009",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 9,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0009",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：03：11"
    },
    {
      "segment_id": "BATCH01-DOC03-S0010",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 10,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0010",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：当时呢，我们要打平型关的那一天，杨成武那个独立团已经到了涞源那个方向，准备打敌人后边，邓华呢带着685团的两个连，他不是685团的副团长嘛，实际上咱们内部是叫政委，他带了两个连呢，在灵丘和广陵中间，扰乱打击敌人。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0011",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 11,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0011",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：04：07"
    },
    {
      "segment_id": "BATCH01-DOC03-S0012",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 12,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0012",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：所以当时看起来，平型关那么多人，那么多兵，那么多武器在那里，所以我们从后面打下去，很有把握了。我们在可能是22号吧，师里面就决心要在23号发起战斗，就在22号往这个作战方向去，往前走。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0013",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 13,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0013",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "    记者：杨老我问一下，在部队开拔之前，有没有交待作战任务和进行战前动员有没有？"
    },
    {
      "segment_id": "BATCH01-DOC03-S0014",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 14,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0014",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：05：00"
    },
    {
      "segment_id": "BATCH01-DOC03-S0015",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 15,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0015",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：有，就在冉庄啊开了干部会议，营以上干部会议。下面要打日本这个问题这已经动员了半年了，冉庄那个会议，是交待任务啊，战术等等，因为我那时候不是营级干部，我是个……现在是叫秘书，那个时候叫技术书记，我没参加那个会。我们的士气呀，没有问题那时候，因为从长征就是北上准备打日本的嘛。“西安事变”以后和平解决了，又进行了差不多半年的教育和训练，无论是思想上、体力上，伙食不是改善了嘛，有大米有白面吃啊，伙食也比过去好了，所以士气和身体都是很好的。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0016",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 16,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0016",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：06：05"
    },
    {
      "segment_id": "BATCH01-DOC03-S0017",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 17,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0017",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：等那一天开进的时候呢，大概到了天黑的时候，就到了宿营地了。我这上面写了，我们那天晚上政治组开会，唐亮主持会议，就说今天晚上就要进入阵地，明天就要进入战斗了，我们必须发扬我们红军的老传统，要打出军威国威来，要给全国人民一个高兴，也是个鼓励。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0018",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 18,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0018",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：07：00"
    },
    {
      "segment_id": "BATCH01-DOC03-S0019",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 19,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0019",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：对国民党投降派也是个打击，对日本军队来说，我们给他长驱直入啊，没有人敢抵抗他，除了南口中央军13军在那里打了以后，以后就是赶鸭子一样，飞机往那面一飞，下面就跑了，阎锡山军队。我们在大营集结之前啊，又走了几天路啊，就碰见他们阎锡山军队退下来，他这个队伍还比较整齐。为什么？没有打。离几十里路，听到炮一响或者飞机一响，他就往后撤。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0020",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 20,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0020",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：08：00"
    },
    {
      "segment_id": "BATCH01-DOC03-S0021",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 21,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0021",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：（说）好厉害啊，这个炮、飞机呀。问他厉害到什么程度啊，你们伤了多少人？不知道。所以这样的时候，就更使得我们这个部队（士气高涨），你没有打你就往后跑，还说厉害，我们这个部队士气就更……就是非打个好仗不行啊。那天晚上唐亮主任是分配组织股、宣传股跟着营里面参加战斗政治鼓励工作，民运股，曾思玉（音）的股长，留在后边，准备接收俘虏，准备动员担架。把我呢，说你协助民运股工作。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0022",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 22,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0022",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：09：06"
    },
    {
      "segment_id": "BATCH01-DOC03-S0023",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 23,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0023",
      "speaker_type": "INTERVIEWEE",
      "segment_type": "ORAL_TESTIMONY",
      "verbatim_text": "    杨永松：那天晚上12点我们部队就出发了，部队出发以后就下雨，到山上，在那里等着进攻开始。部队也淋湿了，也比较冷，但是大家都不会因为这个冷情绪不高，就是第一仗一定要打好。在天亮以后啊，敌人他很警觉，也好像发现了情况，我们看着他好像也发现我们了，我们就发起进攻。"
    },
    {
      "segment_id": "BATCH01-DOC03-S0024",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 24,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0024",
      "speaker_type": "INTERVIEWER",
      "segment_type": "INTERVIEWER_PROMPT",
      "verbatim_text": "    记者：杨老这个时候我问一下，咱们进攻的时候啊，是发的信号弹还是吹的冲锋号？"
    },
    {
      "segment_id": "BATCH01-DOC03-S0025",
      "document_id": "02.杨永松100506（二校后 阅读版）.docx",
      "technical_document_id": "BATCH01-DOC03",
      "segment_order": 25,
      "part": "document",
      "source_block_id": "02.杨永松100506（二校后 阅读版）.docx-B0025",
      "speaker_type": "EDITOR",
      "segment_type": "RECORDING_TIMESTAMP",
      "verbatim_text": "    00：10：10"
    }
  ]
}
