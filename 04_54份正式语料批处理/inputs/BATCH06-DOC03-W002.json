  "task_scope": "正式语料连续窗口盲抽取；事件数量和边界未知。",
  "source_segments": [
    {
      "segment_id": "BATCH06-DOC03-S0020",
      "document_id": "09.杨永松100507（二校后 阅读版）.docx",
      "technical_document_id": "BATCH06-DOC03",
      "segment_order": 20,
